# ───────── Talkie production environment ─────────
# infra/scripts/deploy.sh copies this to .env on the server the first time and fills in the random secrets.
# Then edit the lines marked ✏️. Never commit the real .env.

NODE_ENV=production
LOG_LEVEL=info
PUBLIC_ORIGIN=https://talkie.kodofact.com
CORS_ORIGINS=

# Filled in by deploy.sh (random, 32 bytes each). Changing INTERNAL_TOKEN later is safe; changing OTP_PEPPER
# only invalidates codes that were sent in the last 10 minutes.
INTERNAL_TOKEN=
OTP_PEPPER=

# ✏️ Your own email: it becomes the owner of the admin panel when it signs up (or at its next sign-in).
OWNER_EMAILS=

# ✏️ Email delivery for sign-in codes (required in production: without it nobody can sign in).
# Any SMTP provider works (Amazon SES, Brevo, Mailgun, Zoho, your cPanel mailbox …).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Talkie <no-reply@talkie.kodofact.com>
DEV_LOG_OTP=false

# ✏️ Calls and meetings: LiveKit Cloud project → Settings → Keys. LIVEKIT_URL looks like wss://your-project.livekit.cloud
# In the LiveKit project, add the webhook https://talkie.kodofact.com/api/meet/livekit/webhook
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Files: `disk` keeps encrypted uploads in the media-data Docker volume (one media replica).
# `s3` (Cloudflare R2, Backblaze B2, AWS S3) lets media scale and keeps files off the VPS.
STORAGE_DRIVER=disk
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional meeting recording bucket (S3-compatible).
RECORDING_S3_BUCKET=
RECORDING_S3_REGION=auto
RECORDING_S3_ENDPOINT=
RECORDING_S3_ACCESS_KEY_ID=
RECORDING_S3_SECRET_ACCESS_KEY=

# Database and Redis hosts, users and key files are set by infra/docker-compose.yml.
BUS_DRIVER=redis
