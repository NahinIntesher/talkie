# ───────── Talkie environment ─────────
# Copy with `npm run keys:generate` (creates .env with random secrets). Never commit .env.

NODE_ENV=development
LOG_LEVEL=info
PUBLIC_ORIGIN=http://localhost:3000
CORS_ORIGINS=

# MySQL 8 (production) / MariaDB 10.4+ (local). Each service uses its own database: talkie_auth, talkie_users, …
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_SSL=false

# Event bus: `redis` in production (needs REDIS_URL); `mysql` works locally without Redis.
BUS_DRIVER=mysql
# REDIS_URL=redis://127.0.0.1:6379

# Access-token keys (Ed25519). Created by `npm run keys:generate`.
JWT_PRIVATE_KEY_FILE=secrets/jwt-private.pem
JWT_PUBLIC_KEY_FILE=secrets/jwt-public.pem

# Secrets — `npm run keys:generate` replaces these with random values.
INTERNAL_TOKEN=change-me
OTP_PEPPER=change-me

# Emails that become the platform owner (admin panel) when they sign up. Comma separated.
OWNER_EMAILS=

# Email (sign-in codes). Without SMTP in development, codes are printed in the auth service log.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Talkie <no-reply@talkie.kodofact.com>

# File storage: `disk` (default, keep data/media on persistent storage) or `s3` (Cloudflare R2, Backblaze B2, AWS S3, MinIO)
STORAGE_DRIVER=disk
STORAGE_DIR=data/media
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Calls and meetings: a LiveKit Cloud project (livekit.io → Settings → Keys) or a self-hosted LiveKit server.
# LIVEKIT_URL looks like wss://your-project.livekit.cloud. In the LiveKit project, add the webhook URL
# https://talkie.kodofact.com/api/meet/livekit/webhook so ended rooms and recordings are tracked.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Meeting recording (optional): LiveKit writes MP4 files to this S3-compatible bucket.
RECORDING_S3_BUCKET=
RECORDING_S3_REGION=auto
RECORDING_S3_ENDPOINT=
RECORDING_S3_ACCESS_KEY_ID=
RECORDING_S3_SECRET_ACCESS_KEY=
